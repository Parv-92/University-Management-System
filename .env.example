# Oracle Database Connection Configuration (Thin Mode)
DB_USER=SYSTEM
DB_PASSWORD=your_oracle_password_here
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=FREE
# Note: For Oracle 23ai Free CDB$ROOT, service name is typically FREE.
# If connecting via SID, or another service name, specify accordingly.

# Flask Application Configuration
SECRET_KEY=generate_a_secure_random_secret_key_here
FLASK_APP=app.py
FLASK_DEBUG=False
PORT=5000
